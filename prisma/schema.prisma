// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../dev.db"
}

model User {
  id        String   @id @unique @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(AUDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdAssets Asset[]    @relation("createdBy")
  movement      Movement[]

  Log Log[]
}

model Asset {
  id              String      @id @unique @default(uuid())
  name            String
  description     String      @default("An Asset")
  status          AssetStatus @default(AVAILABLE)
  categoryId      String
  acquisitionDate DateTime
  location        String
  image_url       String?
  createdById     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category  Category @relation(fields: [categoryId], references: [id])
  createdBy User     @relation("createdBy", fields: [createdById], references: [id])
  log       Log[]
}

model Category {
  id          String   @id @unique @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assets      Asset[]
}

model Movement {
  id           String @id @unique @default(uuid())
  assetId      String
  fromLocation String
  toLocation   String

  movedById String
  dateMoved DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movedBy User @relation(fields: [movedById], references: [id])
}

model Log {
  id        String   @id @unique @default(uuid())
  userId    String
  action    Action   @default(REGISTERED)
  assetId   String?
  timestamp DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  asset Asset? @relation(fields: [assetId], references: [id])
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

enum Role {
  ADMIN
  AUDITOR
  ASSET_MANAGER
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  DISPOSED
}

enum Action {
  MOVED
  UPDATED
  REGISTERED
  DELETED
}
